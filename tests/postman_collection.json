            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "my"]
            }
          }
        },
        {
          "name": "Get Chat Info",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/:id",
